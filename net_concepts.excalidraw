    {
      "id": "mprWa4E4xfh5lTb8oZjqF",
      "type": "text",
      "x": -507.48812575567285,
      "y": 1748.280648789576,
      "width": 800,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bIr",
      "roundness": null,
      "seed": 919405791,
      "version": 174,
      "versionNonce": 1173470975,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791493237633,
      "created": 1791493234804,
      "link": null,
      "locked": false,
      "text": "Switch is a device that connects multiple devices in a local network and forwards\nEthernet frames to the correct device",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Switch is a device that connects multiple devices in a local network and forwards Ethernet frames to the correct device",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "cCobv3-HFLJ9k8BxmLE7b",
      "type": "text",
      "x": -437.48812575567285,
      "y": 782.280648789576,
      "width": 635.2594604492188,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bIs",
      "roundness": null,
      "seed": 1505169663,
      "version": 112,
      "versionNonce": 880772895,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791493237633,
      "created": 1791493234804,
      "link": null,
      "locked": false,
      "text": "A create an Ethernet frames and send them as electrical signals ",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A create an Ethernet frames and send them as electrical signals ",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "uZWfZhj1i-Gql0hwpL522",
      "type": "text",
      "x": -486.4881257556733,
      "y": 820.280648789576,
      "width": 800,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bIt",
      "roundness": null,
      "seed": 130717983,
      "version": 177,
      "versionNonce": 2053065535,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791493237633,
      "created": 1791493234804,
      "link": null,
      "locked": false,
      "text": "The switch Operates at layer 2 so it care about mac addresses and forward\ndata to the right destination",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The switch Operates at layer 2 so it care about mac addresses and forward data to the right destination",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "S7GbT6mKSKeiMmN6n--pP",
      "type": "text",
      "x": -484.4881257556733,
      "y": 891.280648789576,
      "width": 800,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bIu",
      "roundness": null,
      "seed": 376970559,
      "version": 148,
      "versionNonce": 1408338783,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791493237633,
      "created": 1791493234804,
      "link": null,
      "locked": false,
      "text": "Before that we use an arp broadcast to recognize the destination ip with its\nmac address",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Before that we use an arp broadcast to recognize the destination ip with its mac address",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "fLNwPPtWNiRv6AQoYpNkQ",
      "type": "text",
      "x": -481.4881257556733,
      "y": 962.280648789576,
      "width": 256.37982177734375,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bIv",
      "roundness": null,
      "seed": 1495276895,
      "version": 161,
      "versionNonce": 495372159,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791493237633,
      "created": 1791493234804,
      "link": null,
      "locked": false,
      "text": "A:\n\"Who has 192.168.1.20?\"\n\n       ↓ ARP broadcast\n\nSwitch\n\n       ↓\n\nB:\n\"192.168.1.20 is me.\nMy MAC is BB:BB:BB:BB.\"",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A:\n\"Who has 192.168.1.20?\"\n\n       ↓ ARP broadcast\n\nSwitch\n\n       ↓\n\nB:\n\"192.168.1.20 is me.\nMy MAC is BB:BB:BB:BB.\"",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "QWujNBbKqYiv-UNYmH7Vb",
      "type": "text",
      "x": -508.4881257556733,
      "y": 1814.280648789576,
      "width": 420.11962890625,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bIw",
      "roundness": null,
      "seed": 1662196095,
      "version": 43,
      "versionNonce": 1432321951,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791493237633,
      "created": 1791493234804,
      "link": null,
      "locked": false,
      "text": "How does the switch learn MAC addresses?",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",

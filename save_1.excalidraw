    },
    {
      "id": "RWpSYujwlJUxcX5jrfG9Y",
      "type": "text",
      "x": 4186.6349206349205,
      "y": 2683.5542438029647,
      "width": 546.5394897460938,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bEw",
      "roundness": null,
      "seed": 476705585,
      "version": 256,
      "versionNonce": 1552598321,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1791493232107,
      "created": 1791493226806,
      "link": null,
      "locked": false,
      "text": "A creates an Ethernet frame containing MAC addresses:\nSource Mac : MAC_A\nDestination Mac : MAC_B",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A creates an Ethernet frame containing MAC addresses:\nSource Mac : MAC_A\nDestination Mac : MAC_B",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "hPPRDkSATEAYdXLF_5uRr",
      "type": "text",
      "x": 4182.6349206349205,
      "y": 2846.5542438029647,
      "width": 800,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bEx",
      "roundness": null,
      "seed": 369517841,
      "version": 95,
      "versionNonce": 441721439,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1791493232107,
      "created": 1791493226806,
      "link": null,
      "locked": false,
      "text": "Then their network interfaces examine the Ethernet frame and determine\nwhether the destination MAC belongs to them",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Then their network interfaces examine the Ethernet frame and determine whether the destination MAC belongs to them",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "2rm2Yfw_hxrD3awsysdux",
      "type": "text",
      "x": 3280.067429799882,
      "y": 3464.050490059418,
      "width": 13.519989013671875,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bEy",
      "roundness": null,
      "seed": 1794743025,
      "version": 114,
      "versionNonce": 2117924625,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1791493232107,
      "created": 1791493226806,
      "link": null,
      "locked": false,
      "text": "A",
      "fontSize": 20,
      "baseFontSize": null,

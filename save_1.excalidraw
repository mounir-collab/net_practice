    {
      "id": "G49FEC5cauGzt9sRcrjVB",
      "type": "text",
      "x": 467.6349206349207,
      "y": 805.5542438029646,
      "width": 800,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",

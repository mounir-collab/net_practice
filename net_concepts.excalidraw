    },
    {
      "id": "_MGQNpziqafG3yydw6uOO",
      "type": "text",
      "x": 377.7329783363946,
      "y": 3789.923505932433,
      "width": 388.15960693359375,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bJg",
      "roundness": null,
      "seed": 1978813918,
      "version": 75,
      "versionNonce": 40760542,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791539347279,
      "created": 1791539145650,
      "link": null,
      "locked": false,
      "text": "routers route data using routing tables",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "routers route data using routing tables",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "HV-5O8TQnePbA1Weiug85",
      "type": "text",
      "x": 373.7329783363946,
      "y": 3829.923505932433,
      "width": 641.139404296875,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bJh",
      "roundness": null,
      "seed": 1728418114,
      "version": 162,
      "versionNonce": 1118616158,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791539349079,
      "created": 1791539170842,
      "link": null,
      "locked": false,
      "text": "Routing table is a file that contains a set of rules that shows\ninformation on what path a data packet takes to its destination",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Routing table is a file that contains a set of rules that shows\ninformation on what path a data packet takes to its destination",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "W14S4dzCFgpQeoYzlldSn",
      "type": "text",
      "x": 372.7329783363946,
      "y": 3914.923505932433,
      "width": 442.1195983886719,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bJi",
      "roundness": null,
      "seed": 1733788162,
      "version": 57,
      "versionNonce": 2084942110,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791539350256,
      "created": 1791539330362,
      "link": null,
      "locked": false,
      "text": "Routing tables are populated in three ways : ",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Routing tables are populated in three ways : ",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "j6zqFuEsBdgPsLWNQwSek",
      "type": "text",
      "x": 384.2329783363946,
      "y": 3964.173505932433,
      "width": 800,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bJk",
      "roundness": null,
      "seed": 659824478,
      "version": 417,
      "versionNonce": 2042048030,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791542038889,
      "created": 1791539364770,
      "link": null,
      "locked": false,
      "text": "Directly connected routes show the routes for the networks are directly\nconnected to an interface \n\nstatic routing are manually configured by network administrators\n\ndynamic routes are entered automatically by neighboring routers so they will\nshare their routing tables by each others using routing protocols",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Directly connected routes show the routes for the networks are directly connected to an interface \n\nstatic routing are manually configured by network administrators\n\ndynamic routes are entered automatically by neighboring routers so they will share their routing tables by each others using routing protocols",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "SKAVnKyhHsMAPZciAvkRB",
      "type": "text",
      "x": 969.7329783363946,
      "y": 5043.923505932433,
      "width": 516.49951171875,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bJl",
      "roundness": null,
      "seed": 1627482690,
      "version": 403,
      "versionNonce": 983614402,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791542170750,
      "created": 1791539700762,
      "link": null,
      "locked": false,
      "text": "once we configure the interfaces of the router \nand give them an ip address and subnet mask \nthe router is going automatically to create a routing\ntable with directly connected routes",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "once we configure the interfaces of the router \nand give them an ip address and subnet mask \nthe router is going automatically to create a routing\ntable with directly connected routes",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },

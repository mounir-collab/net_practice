      "boundElements": null,
      "updated": 1791551867679,
      "created": 1791551864342,
      "link": null,
      "locked": false,
      "text": "Core Technology: Pioneered packet switching (breaking data into smaller chunks\nfor transmission) and later transitioned to the TCP/IP protocol suite on\nJanuary 1, 1983, which laid the groundwork for today's global internet",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Core Technology: Pioneered packet switching (breaking data into smaller chunks for transmission) and later transitioned to the TCP/IP protocol suite on January 1, 1983, which laid the groundwork for today's global internet",

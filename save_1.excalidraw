      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "FEtO7uC1DTTd8AhIWd0lG",
      "type": "text",
      "x": 471.6349206349207,
      "y": 723.5542438029646,
      "width": 546.5394897460938,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bIg",
      "roundness": null,
      "seed": 1563522943,
      "version": 292,
      "versionNonce": 10362271,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791493237633,
      "created": 1791493234804,
      "link": null,
      "locked": false,
      "text": "A creates an Ethernet frame containing MAC addresses:\nSource Mac : MAC_A\nDestination Mac : MAC_B",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A creates an Ethernet frame containing MAC addresses:\nSource Mac : MAC_A\nDestination Mac : MAC_B",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "NIQYws9EKHeMRRFIXp36p",
      "type": "text",
      "x": 467.6349206349207,
      "y": 886.5542438029646,
      "width": 800,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bIh",
      "roundness": null,
      "seed": 741617567,
      "version": 131,
      "versionNonce": 593957311,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791493237633,
      "created": 1791493234804,
      "link": null,
      "locked": false,
      "text": "Then their network interfaces examine the Ethernet frame and determine\nwhether the destination MAC belongs to them",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Then their network interfaces examine the Ethernet frame and determine whether the destination MAC belongs to them",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },

    {
      "id": "0n11uo0ylOCwfrabONft5",
      "type": "text",
      "x": 361.782810756136,
      "y": 2849.05658868031,
      "width": 800,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bJc",
      "roundness": null,
      "seed": 1090035358,
      "version": 1046,
      "versionNonce": 240471106,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791538122818,
      "created": 1791537712879,
      "link": null,
      "locked": false,
      "text": "first send an arp broadcast to know the mac address that belongs to\nthat ip , but the ip is on a different network so we need help\nThe device will create an arp broadcast that has destination ip of the\ndefault gateway and get response from it that contain its mac\nnow the device A will send ethernet frames to the switch and switch \nwill forward it to the router\nthe router operates at layer 3 so it will filter the packet and check the\ndestination ip , also it will send an arp broadcast to know the mac that belong\nto that ip , it get response now forward the packet to the right device  ",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "first send an arp broadcast to know the mac address that belongs to\nthat ip , but the ip is on a different network so we need help\nThe device will create an arp broadcast that has destination ip of the\ndefault gateway and get response from it that contain its mac\nnow the device A will send ethernet frames to the switch and switch \nwill forward it to the router\nthe router operates at layer 3 so it will filter the packet and check the destination ip , also it will send an arp broadcast to know the mac that belong to that ip , it get response now forward the packet to the right device  ",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },

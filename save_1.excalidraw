      "seed": 737616927,
      "version": 173,
      "versionNonce": 529036863,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791493237633,
      "created": 1791493234804,
      "link": null,
      "locked": false,
      "text": "A hub its purpose is to connect all network devices on an internal network",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A hub its purpose is to connect all network devices on an internal network",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "fXTNCiPr-cGgJlXX4eXIu",
      "type": "text",
      "x": 391.1111111111102,
      "y": 1647.8002755489965,
      "width": 800,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bIG",
      "roundness": null,
      "seed": 987449407,
      "version": 204,
      "versionNonce": 1891456607,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791493237633,
      "created": 1791493234804,
      "link": null,
      "locked": false,
      "text": "its a device that has multiple ports that accept ethernet connections from\nnetwork devices",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "its a device that has multiple ports that accept ethernet connections from network devices",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "NvtJY_I2Brv8ALghVBsyo",
      "type": "text",
      "x": 393.33333333333235,
      "y": 1710.0224977712187,
      "width": 800,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bIH",
      "roundness": null,
      "seed": 2112219231,
      "version": 430,
      "versionNonce": 1688285823,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791493237633,
      "created": 1791493234804,
      "link": null,
      "locked": false,
      "text": "A hub is not intelligent to filter any data or to where the data is supposed to\nbe sent , and that is because the only thing a hub know is when a device is\nconnected to one of its ports , so when a data is arrived to one of its ports\nits copied to all of the other ports",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A hub is not intelligent to filter any data or to where the data is supposed to be sent , and that is because the only thing a hub know is when a device is connected to one of its ports , so when a data is arrived to one of its ports its copied to all of the other ports",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "IHfLXUuXO75TAqCB_LT0S",
      "type": "text",
      "x": 402.22222222222126,
      "y": 1834.466942215663,
      "width": 800,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bII",
      "roundness": null,
      "seed": 585598079,
      "version": 220,
      "versionNonce": 1140099743,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791493237633,
      "created": 1791493234804,
      "link": null,
      "locked": false,
      "text": "The hub rebroadcast every arrived data packet to all its ports that has a\ndevice connected to it",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The hub rebroadcast every arrived data packet to all its ports that has a device connected to it",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },

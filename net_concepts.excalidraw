      "version": 294,
      "versionNonce": 1624082655,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791062453698,
      "created": 1791061533012,
      "link": null,
      "locked": false,
      "text": "The hub doesn't look at these MAC addresses. It simply takes the physical\nsignal arriving on one port and repeats it on the other ports\nso it sent to every device connected to the hub",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The hub doesn't look at these MAC addresses. It simply takes the physical signal arriving on one port and repeats it on the other ports\nso it sent to every device connected to the hub",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "SyXE1Lv9jFvSXw5DwK2Ka",
      "type": "text",
      "x": 939.6349206349205,
      "y": 1047.9559884559887,
      "width": 388.899658203125,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bBd",
      "roundness": null,
      "seed": 468477041,
      "version": 343,
      "versionNonce": 2030507263,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791062453698,
      "created": 1791061662493,
      "link": null,
      "locked": false,
      "text": "So the HUB operates at the Osi layer 1",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,

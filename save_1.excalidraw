      "updated": 1791493232107,
      "created": 1791493226806,
      "link": null,
      "locked": false,
      "text": "what is an ethernet frame :",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "what is an ethernet frame :",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "gObv5ujmQmMm2dT_6nay4",
      "type": "text",
      "x": 3209.6092768417293,
      "y": 4261.546882555811,
      "width": 609.306640625,
      "height": 325,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bFV",
      "roundness": null,
      "seed": 808882385,
      "version": 383,
      "versionNonce": 284303487,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1791493232107,
      "created": 1791493226806,
      "link": null,
      "locked": false,
      "text": "┌─────────────────────────────────────────┐\n│ Ethernet Frame                          │\n│                                         │\n│ Source MAC:      AA:AA:AA:AA            │\n│ Destination MAC: BB:BB:BB:BB            │\n│                                         │\n│ ┌─────────────────────────────────────┐ │\n│ │ IP Packet                           │ │\n│ │ Source IP:      192.168.1.10        │ │\n│ │ Destination IP: 192.168.1.20        │ │\n│ │ ICMP Echo Request                   │ │\n│ └─────────────────────────────────────┘ │\n└─────────────────────────────────────────┘",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "┌─────────────────────────────────────────┐\n│ Ethernet Frame                          │\n│                                         │\n│ Source MAC:      AA:AA:AA:AA            │\n│ Destination MAC: BB:BB:BB:BB            │\n│                                         │\n│ ┌─────────────────────────────────────┐ │\n│ │ IP Packet                           │ │\n│ │ Source IP:      192.168.1.10        │ │\n│ │ Destination IP: 192.168.1.20        │ │\n│ │ ICMP Echo Request                   │ │\n│ └─────────────────────────────────────┘ │\n└─────────────────────────────────────────┘",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "sPWGisQIjVpAljBiLS-vw",
      "type": "line",
      "x": 4048.6092768417293,
      "y": 4372.546882555811,
      "width": 10,
      "height": 712,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bFW",

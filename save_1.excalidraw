    {
      "id": "2x87JVHLOsQwBkwNscULb",
      "type": "text",
      "x": 4107.222222222222,
      "y": 3568.911386660108,
      "width": 726.9192504882812,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",

      "text": "what is an ethernet frame :",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "what is an ethernet frame :",

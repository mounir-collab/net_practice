      "versionNonce": 1528385687,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791578732641,
      "created": 1791578637600,
      "link": null,
      "locked": false,
      "text": "The process of passing from layer to layer from top to bottom is encapuslation\nand the opposite is de-encapsulation",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The process of passing from layer to layer from top to bottom is encapuslation\nand the opposite is de-encapsulation",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "K-7zHjoQbfi9iv_QU3Cmu",
      "type": "text",
      "x": 1905.985191708518,
      "y": 2268.467302966023,
      "width": 800,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bKt",
      "roundness": null,
      "seed": 1255039991,
      "version": 460,
      "versionNonce": 1043622071,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791579153728,
      "created": 1791578737311,
      "link": null,
      "locked": false,
      "text": "so we pass from the application layer which is a data that can be a get\nrequest...\nwe encapsulate it into a HTTP header\nwe encapsulate the Transport layer into a segment or layer 4 header\nalso we encapsulate the network layer into a layer 3 header or ip header\nwe encapsulate the data link layer into a ethernet header we add also an\nethernet trailer also at the end and now we have an ethernet frame\n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "so we pass from the application layer which is a data that can be a get request...\nwe encapsulate it into a HTTP header\nwe encapsulate the Transport layer into a segment or layer 4 header\nalso we encapsulate the network layer into a layer 3 header or ip header\nwe encapsulate the data link layer into a ethernet header we add also an ethernet trailer also at the end and now we have an ethernet frame\n",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },

    {
      "id": "oBnFrpMX7sHfTqiAjUlON",
      "type": "text",
      "x": 3207.5118742443274,
      "y": 3708.280648789576,
      "width": 800,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bF7",
      "roundness": null,
      "seed": 331117521,
      "version": 138,
      "versionNonce": 184010495,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1791493232107,
      "created": 1791493226806,
      "link": null,
      "locked": false,
      "text": "Switch is a device that connects multiple devices in a local network and forwards\nEthernet frames to the correct device",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Switch is a device that connects multiple devices in a local network and forwards Ethernet frames to the correct device",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "EXcyuabzvyLVsqOpQtsXe",
      "type": "text",
      "x": 3277.5118742443274,
      "y": 2742.280648789576,
      "width": 635.2594604492188,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bF8",
      "roundness": null,
      "seed": 1283445169,
      "version": 76,
      "versionNonce": 378236017,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1791493232107,
      "created": 1791493226806,
      "link": null,
      "locked": false,
      "text": "A create an Ethernet frames and send them as electrical signals ",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A create an Ethernet frames and send them as electrical signals ",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "v0Sz504z1IVQ1dxES7Isj",
      "type": "text",
      "x": 3228.5118742443265,
      "y": 2780.280648789576,
      "width": 800,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bF9",
      "roundness": null,
      "seed": 886862737,
      "version": 141,
      "versionNonce": 2072284959,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1791493232107,
      "created": 1791493226806,
      "link": null,
      "locked": false,
      "text": "The switch Operates at layer 2 so it care about mac addresses and forward\ndata to the right destination",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The switch Operates at layer 2 so it care about mac addresses and forward data to the right destination",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "vXV_qTOfJSCAseP5zcqth",
      "type": "text",
      "x": 3230.5118742443265,
      "y": 2851.280648789576,
      "width": 800,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bFA",
      "roundness": null,
      "seed": 285858161,
      "version": 112,
      "versionNonce": 1478932049,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1791493232107,
      "created": 1791493226806,
      "link": null,
      "locked": false,
      "text": "Before that we use an arp broadcast to recognize the destination ip with its\nmac address",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Before that we use an arp broadcast to recognize the destination ip with its mac address",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "IS79D8QoVbC4nedxMTU02",
      "type": "text",
      "x": 3233.5118742443265,
      "y": 2922.280648789576,
      "width": 256.37982177734375,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bFB",
      "roundness": null,
      "seed": 844071761,
      "version": 125,
      "versionNonce": 730026815,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1791493232107,
      "created": 1791493226806,
      "link": null,
      "locked": false,
      "text": "A:\n\"Who has 192.168.1.20?\"\n\n       ↓ ARP broadcast\n\nSwitch\n\n       ↓\n\nB:\n\"192.168.1.20 is me.\nMy MAC is BB:BB:BB:BB.\"",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A:\n\"Who has 192.168.1.20?\"\n\n       ↓ ARP broadcast\n\nSwitch\n\n       ↓\n\nB:\n\"192.168.1.20 is me.\nMy MAC is BB:BB:BB:BB.\"",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "AXsNSHe4QPqxyPNv7Ndwv",
      "type": "text",
      "x": 3206.5118742443265,
      "y": 3774.280648789576,
      "width": 420.11962890625,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",

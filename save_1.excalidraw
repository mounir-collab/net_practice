    {
      "id": "pvii_c6Xz-LlMyKOZKbj6",
      "type": "text",
      "x": 392.22222222222126,
      "y": 1608.9113866601078,
      "width": 726.9192504882812,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,

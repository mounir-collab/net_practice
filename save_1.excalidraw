      "text": "Data / Payload           \n                                  \n        \"Hello!\" ",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Data / Payload           \n                                  \n        \"Hello!\" ",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "EF0Lin7ujmUytNutmYLvb",
      "type": "text",
      "x": 937.6349206349205,
      "y": 821.9559884559887,
      "width": 546.5394897460938,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bBk",
      "roundness": null,
      "seed": 360013105,
      "version": 253,
      "versionNonce": 1529518463,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1791493226106,
      "created": 1791062175939,
      "link": null,
      "locked": false,
      "text": "A creates an Ethernet frame containing MAC addresses:\nSource Mac : MAC_A\nDestination Mac : MAC_B",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A creates an Ethernet frame containing MAC addresses:\nSource Mac : MAC_A\nDestination Mac : MAC_B",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "eqBn3sGrVoPKgrRB3cG2j",
      "type": "text",
      "x": 933.6349206349205,
      "y": 984.9559884559887,
      "width": 800,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bBo",
      "roundness": null,
      "seed": 1086114193,
      "version": 92,
      "versionNonce": 897909233,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1791493226106,
      "created": 1791062420425,
      "link": null,
      "locked": false,
      "text": "Then their network interfaces examine the Ethernet frame and determine\nwhether the destination MAC belongs to them",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Then their network interfaces examine the Ethernet frame and determine whether the destination MAC belongs to them",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },

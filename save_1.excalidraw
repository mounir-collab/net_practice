    {
      "id": "hjZJnzDbUPyod9Y2uM8cu",
      "type": "text",
      "x": 933.6349206349205,
      "y": 903.9559884559887,
      "width": 800,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",

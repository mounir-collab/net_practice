    {
      "id": "nGFSdK0VhZnPAZjzRPpfM",
      "type": "text",
      "x": -364.3907231582705,
      "y": 2221.5468825558105,
      "width": 268.1797790527344,
      "height": 25,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",

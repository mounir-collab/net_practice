      "updated": 1791493237634,
      "created": 1791493234805,
      "link": null,
      "locked": false,
      "text": "what is an ethernet frame :",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "what is an ethernet frame :",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "b4UNYDni0QrTzgGkS4SWa",
      "type": "text",
      "x": -505.3907231582705,
      "y": 2301.5468825558105,
      "width": 609.306640625,
      "height": 325,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bJF",
      "roundness": null,
      "seed": 2060179423,
      "version": 419,
      "versionNonce": 1517564415,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791493237634,
      "created": 1791493234805,
      "link": null,
      "locked": false,
      "text": "┌─────────────────────────────────────────┐\n│ Ethernet Frame                          │\n│                                         │\n│ Source MAC:      AA:AA:AA:AA            │\n│ Destination MAC: BB:BB:BB:BB            │\n│                                         │\n│ ┌─────────────────────────────────────┐ │\n│ │ IP Packet                           │ │\n│ │ Source IP:      192.168.1.10        │ │\n│ │ Destination IP: 192.168.1.20        │ │\n│ │ ICMP Echo Request                   │ │\n│ └─────────────────────────────────────┘ │\n└─────────────────────────────────────────┘",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "┌─────────────────────────────────────────┐\n│ Ethernet Frame                          │\n│                                         │\n│ Source MAC:      AA:AA:AA:AA            │\n│ Destination MAC: BB:BB:BB:BB            │\n│                                         │\n│ ┌─────────────────────────────────────┐ │\n│ │ IP Packet                           │ │\n│ │ Source IP:      192.168.1.10        │ │\n│ │ Destination IP: 192.168.1.20        │ │\n│ │ ICMP Echo Request                   │ │\n│ └─────────────────────────────────────┘ │\n└─────────────────────────────────────────┘",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "JyDcW9R-YMwUdwkfBU9cN",
      "type": "line",
      "x": 333.6092768417293,
      "y": 2412.5468825558105,
      "width": 10,
      "height": 712,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
